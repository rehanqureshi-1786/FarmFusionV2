# FarmFusion Backend Environment Variables
# Copy this file to .env and fill in your values

# ================================
# AI SERVICES (FREE TIER)
# ================================

# Groq API - Primary AI (1M tokens/day free)
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API - Backup (1500 req/day free)
# Get your key at: https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key

# Local AI (Ollama) - 100% free, runs locally
# Install from: https://ollama.com
USE_LOCAL_AI=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ================================
# EXTERNAL APIs
# ================================

# Weather API (OpenWeatherMap - 1000 calls/day free)
# Get your key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# Market Data API (optional)
MARKET_API_KEY=your_market_api_key

# ================================
# DATABASE
# ================================

# SQLite (default, no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./farmfusion.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/farmfusion

# ================================
# FIREBASE CONFIGURATION
# ================================

# Get from Firebase Console → Project Settings → General
FIREBASE_PROJECT_ID=farmfusion-your-project-id

# Path to service account JSON file (optional, for admin features)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# ================================
# APP SETTINGS
# ================================

APP_NAME=FarmFusion API
DEBUG=true
VERSION=1.0.0

# CORS Origins (for Android app)
# In development, allow all origins
ALLOWED_ORIGINS=["*"]

# In production, use specific origins:
# ALLOWED_ORIGINS=["https://yourdomain.com", "http://localhost"]
