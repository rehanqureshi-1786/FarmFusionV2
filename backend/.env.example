# FarmFusion Backend Environment Variables
# Copy this file to .env and fill in your values

# ================================
# AI SERVICES (FREE TIER)
# ================================

# Groq API - Primary AI (1M tokens/day free)
# Get your key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API - Backup (1500 req/day free)
# Get your key at: https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key

# Local AI (Ollama) - 100% free, runs locally
# Install from: https://ollama.com
USE_LOCAL_AI=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ================================
# EXTERNAL APIs
# ================================

# Weather API (OpenWeatherMap - 1000 calls/day free)
# Get your key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# Market Data API (optional)
MARKET_API_KEY=your_market_api_key

# ================================
# CROP RECOMMENDATION - TRAINED XGBOOST (No Soil Report flow)
# ================================
# Paths to the trained artifacts (do not retrain / replacement).
CROP_MODEL_PATH=app/ml_models/crop_recommendation.joblib
CROP_LABEL_ENCODER_PATH=app/ml_models/crop_label_encoder.joblib
CROP_MODEL_METADATA_PATH=app/ml_models/crop_model_metadata.json

# Soil Data Service (SoilGrids/ISRIC) - used for the "No Soil Report" flow.
# SoilGrids provides pH and soil texture from lat/lon via a free public API.
# No API key required. N/P/K are NOT provided by this service as they
# represent different scientific quantities (concentration vs. stock units)
# and cannot be converted without ground-truth calibration.
# 
# If N/P/K are required, use the "I Have Soil Report" flow with lab-tested values.

# ================================
# DATABASE
# ================================

# PostgreSQL with pgvector (production recommended)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/farmfusion
# Fallback SQLite for local scratch runs
# DATABASE_URL=sqlite+aiosqlite:///./farmfusion.db

# ================================
# MULTILINGUAL VOICE & TELEPHONY (F7)
# ================================

# Sarvam AI - Indic ASR & TTS (Primary)
SARVAM_API_KEY=your_sarvam_api_key_here

# OpenRouter - Primary LLM fallback (gemma-3-12b-it)
OPENROUTER_API_KEY=sk-or-your_openrouter_api_key_here

# Deepgram - Telephony streaming STT
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Bhashini API (Optional alternate Indian languages provider)
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id

# Vobiz AI Telephony Gateway (Kisan Calling Agent)
VOBIZ_ACCOUNT_ID=your_vobiz_account_id_here
VOBIZ_API_KEY=your_vobiz_api_key_here
VOBIZ_PHONE_NUMBER=+918065354620

# Public Service URLs for Telephony Webhooks & WebSockets
# In development use ngrok/localtunnel (e.g. https://xxxx.ngrok-free.app)
# In production use your public HTTPS and WSS domain
BASE_URL=http://localhost:8000
BASE_WS_URL=ws://localhost:8000

# ================================
# FIREBASE CONFIGURATION
# ================================

# Get from Firebase Console → Project Settings → General
FIREBASE_PROJECT_ID=farmfusion-your-project-id

# Path to service account JSON file (optional, for admin features)
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# ================================
# APP SETTINGS & DEPLOYMENT
# ================================

APP_NAME=FarmFusion API
DEBUG=false
VERSION=1.0.0
PORT=8000

# Security secret key (generate using: openssl rand -hex 32)
SECRET_KEY=generate_a_secure_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (for Android app)
# In development, allow all origins:
ALLOWED_ORIGINS=["*"]
# In production, specify your domains:
# ALLOWED_ORIGINS=["https://api.farmfusion.app", "https://farmfusion1.onrender.com"]

