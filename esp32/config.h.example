#ifndef CONFIG_H
#define CONFIG_H

// ============================================================================
// FarmFusion ESP32 IoT Node Configuration Template
// Copy this file to config.h or configure animal_detection.ino directly.
// DO NOT COMMIT REAL CREDENTIALS OR PRIVATE LAN IPS TO VERSION CONTROL.
// ============================================================================

// Wi-Fi Credentials
#define WIFI_SSID       "YOUR_WIFI_SSID"
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"

// FarmFusion Backend Production Host / Domain
// For production, use public DNS hostname (e.g., api.farmfusion.app)
// For local staging/lab testing, use your gateway or local machine IP (e.g., 10.0.0.X)
#define SERVER_HOST     "api.farmfusion.app"
#define SERVER_PORT     80

// Unique Device / Node Identifier
#define DEVICE_ID       "NODE_01"

#endif // CONFIG_H
